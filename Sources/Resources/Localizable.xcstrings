    "Pick a message from the list, or Get Mail to fetch new ones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر رسالة من القائمة، أو احصل على البريد لجلب الرسائل الجديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte zprávu ze seznamu nebo použijte Získat poštu pro načtení nových."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wählen Sie eine Nachricht aus der Liste oder rufen Sie Post ab, um neue zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecciona un mensaje de la lista o pulsa Obtener correo para buscar nuevos mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sélectionnez un message dans la liste ou utilisez « Obtenir les messages » pour en récupérer de nouveaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleziona un messaggio dall'elenco o Scarica posta per recuperare nuovi messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リストからメッセージを選択するか、[メールの取得] で新しいメッセージを取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "목록에서 메시지를 선택하거나 '메일 가져오기'를 눌러 새 메시지를 받아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecione uma mensagem da lista ou Obter Correio para buscar novas mensagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите сообщение из списка или нажмите «Получить почту» для загрузки новых."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
