    "Select an invoice, or create one — publish A4 tax invoice PDFs straight into MaestroDAM, export to Xero anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حدد فاتورة، أو أنشئ واحدة — انشر ملفات PDF لفواتير ضريبية بحجم A4 مباشرة في MaestroDAM، وصدّر إلى Xero في أي وقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte fakturu nebo ji vytvořte — publikujte daňové faktury PDF formátu A4 přímo do MaestroDAM, kdykoli exportujte do Xera."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg en faktura, eller opret en — udgiv A4-fakturerings-PDF'er direkte i MaestroDAM, eksportér til Xero når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Rechnung auswählen oder erstellen — A4-Steuerrechnungen als PDF direkt in MaestroDAM veröffentlichen, jederzeit nach Xero exportieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε τιμολόγιο ή δημιουργήστε ένα — δημοσιεύστε PDF φορολογικών τιμολογίων A4 απευθείας στο MaestroDAM, εξάγετε στο Xero οποιαδήποτε στιγμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seleccione una factura o cree una: publique PDF de facturas fiscales A4 directamente en MaestroDAM y exporte a Xero en cualquier momento."
