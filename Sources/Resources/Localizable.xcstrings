    "Scanning identifies changed files, then uploads them to your VPS. Both happen together.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحدد المسح الملفات المتغيرة، ثم يرفعها إلى خادمك الافتراضي الخاص. يحدث الاثنان معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Scannen identifiziert geänderte Dateien und lädt sie dann auf Ihren VPS hoch. Beides erfolgt gleichzeitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escaneo identifica los archivos modificados y luego los sube a tu VPS. Ambos procesos ocurren simultáneamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'analyse identifie les fichiers modifiés, puis les télécharge vers votre VPS. Les deux actions se produisent simultanément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scansione individua i file modificati e li carica sul tuo VPS. Entrambi gli eventi avvengono contemporaneamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スキャンは変更されたファイルを特定し、VPS にアップロードします。両者は同時に行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "변경된 파일을 식별한 후 VPS 로 업로드합니다. 두 작업이 동시에 이루어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A digitalização identifica arquivos alterados e os envia para sua VPS. Ambos ocorrem simultaneamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При сканировании определяются изменённые файлы и загружаются на ваш VPS. Оба действия выполняются одновременно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "扫描会识别已更改的文件，然后将其上传到您的 VPS。两者同时发生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "掃描會識別已變更的檔案，然後將它們上傳至您的 VPS。兩者同時進行。"
          }
        }
      }
    },
