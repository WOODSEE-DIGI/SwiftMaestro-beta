    "Pick a message from the list, or Get Mail to fetch new ones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر رسالة من القائمة، أو احصل على البريد لجلب الرسائل الجديدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte zprávu ze seznamu nebo použijte Získat poštu pro načtení nových."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg en besked fra listen, eller Hent e-mail for at hente nye."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählen Sie eine Nachricht aus der Liste oder rufen Sie Post ab, um neue zu laden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε μήνυμα από τη λίστα ή πατήστε Λήψη αλληλογραφίας για να φέρετε νέα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selecciona un mensaje de la lista o pulsa Obtener correo para buscar nuevos mensajes."
          }
        },
        "es-419" : {
