    "Cards default to the accent color; card text always contrasts against the card." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "البطاقات تستخدم لون التمييز افتراضيًا؛ يتباين نص البطاقة دائمًا مع خلفية البطاقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karty mají výchozí barvu akcentu; text karet je vždy kontrastní vůči kartě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Korter bruger standardfarven som akcentfarve; kortteksten har altid kontrast til kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Karten verwenden standardmäßig die Akzentfarbe; Kartentext steht immer im Kontrast zur Karte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι κάρτες χρησιμοποιούν προεπιλεγμένα το χρώμα έμφασης· το κείμενο της κάρτας πάντα δημιουργεί αντίθεση με την κάρτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las tarjetas usan el color de acento por defecto; el texto siempre contrasta con la tarjeta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las tarjetas usan el color de acento por defecto; el texto de la tarjeta siempre contrasta con la tarjeta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oletuskortit käyttävät väriä; kortin teksti on aina erottuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les cartes utilisent par défaut la couleur d'accentuation ; le texte des cartes contraste toujours avec la carte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כרטיסים מוגדרים כברירת מחדל לצבע הדגש; טקסט הכרטיס תמיד מתבדל מהכרטיס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कार्ड डिफ़ॉल्ट रूप से एक्सेंट रंग का होते हैं; कार्ड पाठ हमेशा कार्ड के विपरीत दिखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
