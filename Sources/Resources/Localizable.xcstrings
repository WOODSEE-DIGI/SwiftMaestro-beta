    "Import a folder to start building your catalog.\\nRatings, tags, and AI keywording stay on this Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استيراد مجلد للبدء في بناء كتالوجك.\\nالتقييمات والوسوم والكلمات المفتاحية بالذكاء الاصطناعي تبقى على هذا Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importovat složku pro zahájení tvorby katalogu.\\nHodnocení, štítky a AI klíčová slova zůstanou na tomto Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einen Ordner importieren, um Ihren Katalog zu erstellen.\\nBewertungen, Tags und AI-Schlagwörter verbleiben auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importar una carpeta para comenzar a construir su catálogo.\nLas calificaciones, etiquetas y etiquetado automático con IA permanecen en este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダをインポートしてカタログの作成を開始します。\\n評価、タグ、AI キーワードはこの Mac に保持されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Importe uma pasta para começar a criar seu catálogo.\\nClassificações, tags e palavras-chave da IA permanecem neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Импортируйте папку для начала создания каталога.\\nОценки, теги и ИИ-ключевые слова останутся на этом Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "导入文件夹以开始建立您的目录。\\n评分、标签和 AI 关键词将保留在此 Mac 上。"
          }
        }
      }
    },
