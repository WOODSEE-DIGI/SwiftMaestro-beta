    "Audio saves to disk the moment you start — transcription follows in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُحفظ الصوت على القرص فور البدء — تتبع النسخ النصي في الخلفية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zvuk se ukládá na disk okamžitě po spuštění — přepis probíhá na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lyd gemmes til disken øjeblikket du starter — transkription følger i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Audio wird sofort bei Start auf Festplatte gespeichert – Transkription erfolgt im Hintergrund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο ήχος αποθηκεύεται στον δίσκο μόλις ξεκινήσετε — η μεταγραφή ακολουθεί στο παρασκήνιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El audio se guarda en disco al instante al iniciar — la transcripción continúa en segundo plano."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El audio se guarda en disco al iniciar: la transcripción continúa en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ääni tallennetaan levylle heti kun aloitat — transkriptio seuraa taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'audio est enregistré sur le disque dès que vous commencez — la transcription suit en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "האודיו נשמר לדיסק ברגע ההתחלה — התמלול מתבצע ברקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "शुरुआत करते ही ऑडियो डिस्क पर सहेजा जाता है — पृष्ठभूमि में अनुलिपिकरण जारी रहता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hang rögzítése azonnal lemezre történik indításkor – a transzkripció a háttérben következik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
