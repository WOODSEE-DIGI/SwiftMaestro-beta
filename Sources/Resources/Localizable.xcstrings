    "Split any pane right/down, or close one — each pane is its own process and survives splits": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قسّم أي لوحة يمينًا/أسفل، أو أغلق واحدة - كل لوحة هي عملية مستقلة وتبقى عند القسمة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fenster nach rechts/unten teilen oder eines schließen — jedes Fenster ist ein eigener Prozess und bleibt bei Aufteilungen erhalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divide cualquier panel a la derecha/abajo o ciérralo — cada panel es un proceso independiente y sobrevive a las divisiones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divisez n'importe quel volet vers la droite/vers le bas, ou fermez-en un — chaque volet est son propre processus et survit aux divisions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dividi qualsiasi riquadro verso destra/basso o chiudine uno — ogni riquadro è un processo autonomo e sopravvive alle divisioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任意のペインを右/下に分割、または 1 つ閉じる — 各ペインは独立したプロセスであり、分割後も存続します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "어떤 패널도 오른쪽/아래로 나누거나 닫을 수 있습니다. 각 패널은 독립 프로세스이며 분할 후에도 유지됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Divida qualquer painel à direita/abaixo, ou feche um — cada painel é seu próprio processo e sobrevive às divisões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разделите любую панель вправо/вниз или закройте её — каждая панель является отдельным процессом и сохраняется при разделении"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割任意面板向右/向下，或关闭一个 — 每个面板都是独立进程且可在分割后保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分割任何窗格向右/向下，或關閉一個 — 每個窗格都是獨立流程且能在分割後保留"
          }
        }
      }
    },
