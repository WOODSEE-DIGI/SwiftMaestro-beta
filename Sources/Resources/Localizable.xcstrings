    "Split any pane right/down, or close one — each pane is its own process and survives splits" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قسّم أي لوحة يمينًا/أسفل، أو أغلق واحدة - كل لوحة هي عملية مستقلة وتبقى عند القسمة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozdělte libovolný panel doprava/dolů nebo jej zavřete – každý panel je samostatný proces a přežije rozdělení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Del ethvert panel til højre/ned, eller luk et – hvert panel er sin egen proces og overlever opdelinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fenster nach rechts/unten teilen oder eines schließen — jedes Fenster ist ein eigener Prozess und bleibt bei Aufteilungen erhalten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διαίρεση οποιασδήποτε περιοχής δεξιά/κάτω ή κλείστε μία — κάθε περιοχή είναι δική της διεργασία και επιβιώνει τις διαιρέσεις"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Divide cualquier panel a la derecha/abajo o ciérralo — cada panel es un proceso independiente y sobrevive a las divisiones"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Divide cualquier panel a la derecha o abajo, o ciérralo. Cada panel es un proceso independiente que persiste al dividir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jaa mikä tahansa ruutu oikealle/alas tai sulje se — jokainen ruutu on oma prosessinsa ja säilyy jakautumisessa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Divisez n'importe quel volet vers la droite/vers le bas, ou fermez-en un — chaque volet est son propre processus et survit aux divisions"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פצל כל תיבה ימינה או למטה, או סגור אחת - כל תיבה היא תהליך נפרד ונשמרת בפיצולים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी भी पैनल को दाएँ या नीचे विभाजित करें, या बंद करें — हर पैनल अपनी स्वतंत्र प्रक्रिया है और विभाजन के बाद भी बना रहता है"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bármelyik nézetet jobbra vagy lent bonthatja, vagy bezárhatja – minden nézet saját folyamat, és megmarad a felosztások után."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bagi panel manapun ke kanan/bawah, atau tutup satu — setiap panel adalah proses sendiri dan bertahan dari pembagian"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dividi qualsiasi riquadro verso destra/basso o chiudine uno — ogni riquadro è un processo autonomo e sopravvive alle divisioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "任意のペインを右/下に分割、または 1 つ閉じる — 各ペインは独立したプロセスであり、分割後も存続します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "어떤 패널도 오른쪽/아래로 나누거나 닫을 수 있습니다. 각 패널은 독립 프로세스이며 분할 후에도 유지됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
