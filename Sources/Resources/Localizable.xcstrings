    "The message text moves back into the input, and %@ message(s) from that point on are deleted. This cannot be undone." : {
      "comment" : "A message box explaining that reverting to a message deletes all subsequent messages.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ينتقل نص الرسالة مرة أخرى إلى حقل الإدخال، ويتم حذف %@ رسالةً من تلك النقطة فصاعدًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Text zprávy se vrátí zpět do vstupního pole a od tohoto bodu jsou smazány %@ zpráva(y). To nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beskedteksten flyttes tilbage til indtastningsfeltet, og %@ besked(er) fra dette tidspunkt slettes. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
