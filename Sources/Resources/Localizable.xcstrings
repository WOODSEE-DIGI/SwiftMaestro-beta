    "Sampling below is saved for this model and applies wherever it runs — for every agent that uses it. Each model keeps its own values." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُحفظ أخذ العينات أدناه لهذا النموذج وينطبق أينما تم تشغيله — لكل وكيل يستخدمه. يحتفظ كل نموذج بقيمه الخاصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výběr níže je uložen pro tento model a platí, kdekoliv běží — pro každého agenta, který jej používá. Každý model si uchovává své vlastní hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stikprøve nedenfor gemmes for denne model og gælder, hvor den kører — for hver agent, der bruger den. Hver model beholder sine egne værdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die untenstehende Abtastung wird für dieses Modell gespeichert und gilt überall, wo es ausgeführt wird — für jeden Agenten, der es verwendet. Jedes Modell behält seine eigenen Werte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η δειγματοληψία παρακάτω αποθηκεύεται για αυτό το μοντέλο και ισχύει όπου κι αν εκτελείται — για κάθε πράκτορα που το χρησιμοποιεί. Κάθε μοντέλο διατηρεί τις δικές του τιμές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El muestreo que aparece a continuación está guardado para este modelo y se aplica donde sea que se ejecute — para cada agente que lo usa. Cada modelo mantiene sus propios valores."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El muestreo de abajo se guarda para este modelo y se aplica en cualquier lugar donde se ejecute — para cada agente que lo utiliza. Cada modelo conserva sus propios valores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seuraava otanta tallennetaan tälle mallille ja se koskee kaikkia paikkoja, joissa sitä käytetään — jokaista siihen käyttävää agenttia varten. Jokainen malli säilyttää omat arvonsa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'échantillonnage ci-dessous est enregistré pour ce modèle et s'applique partout où il fonctionne — pour chaque agent qui l'utilise. Chaque modèle conserve ses propres valeurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "דגימת המידע למטה נשמרת עבור הדגם הזה ומופעת בכל מקום שבו היא מופעלת — לכל סוכן המשתמש בה. לכל דגם יש ערכים משלו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नीचे दिया गया सैंपलिंग इस मॉडल के लिए सहेजा जाता है और जहाँ भी यह चलता है, वहां लागू होता है — इसे उपयोग करने वाले प्रत्येक एजेंट के लिए। प्रत्येक मॉडल अपने मान रखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az alábbi mintavételezés ehhez a modellhez van mentve, és mindenhol érvényesül, ahol fut — minden olyan ügynök számára, amely használja. Minden modellnek megvannak a saját értékei."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pengambilan sampel di bawah ini disimpan untuk model ini dan berlaku di mana pun dijalankan — untuk setiap agen yang menggunakannya. Setiap model menyimpan nilainya sendiri."
