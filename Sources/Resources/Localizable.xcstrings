    "Board view groups cards by a single-select field. Switch to the grid and add one — e.g. Status: Booked, Shooting, Delivered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض اللوحة البطاقات مجمّعة حسب حقل اختيار واحد. انتقل إلى الشبكة وأضف حقلًا مثل: الحالة: محجوز، تصوير، مُسلّم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zobrazení desky seskupuje karty podle jednoho výběrového pole. Přepněte se na mřížku a přidejte jedno — např. Stav: Rezervováno, Natáčení, Dodáno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tavlevisning grupperer kort efter et felt med enkeltvalg. Skift til gitteret og tilføj ét – f.eks. Status: Bogført, Optagelse, Leveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Board-Ansicht gruppiert Karten nach einem Einzelauswahlfeld. Wechseln Sie zur Gitteransicht und fügen Sie eines hinzu — z. B. Status: Gebucht, Shooting, Ausgeliefert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η προβολή Πίνακας ομαδοποιεί τις κάρτες με βάση ένα πεδίο μονής επιλογής. Εναλλαγή σε πλέγμα και προσθήκη ενός — π.χ. Κατάσταση: Κρατημένο, Γυρίσματα, Παρεχόμενο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vista de tableros agrupa tarjetas por un campo de selección única. Cambie a la vista en cuadrícula y añada uno — p. ej. Estado: Reservado, En rodaje, Entregado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vista de tablero agrupa las tarjetas por un campo de selección única. Cambia a la cuadrícula y agrega uno — p. ej., Estado: Reservado, En grabación, Entregado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Taulu-näkymä ryhmittelee kortit yhden valintakentän mukaan. Siirry ruudukkonäkymään ja lisää kenttä — esim. Tila: Varattu, Kuvaus, Toimitettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vue tableau regroupe les cartes par un champ à sélection unique. Passez en grille et ajoutez-en un — ex. Statut : Réservé, Prise de vue, Livré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תצוגת הלוח מסדרת כרטיסים לפי שדה לבחירה יחידה. מעבר לתצוגת רשת והוספת אחד — למשל: מצב: שמור, צילום, נמסר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बोर्ड दृश्य कार्ड्स को एकल-चयन फ़ील्ड के आधार पर समूहित करता है। ग्रिड में स्विच करें और एक जोड़ें — उदाहरण: स्थिति: बुक किया गया, शूटिंग, डिलीवर किया गया।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A táblanézet kártyákat csoportosít egy választómező alapján. Váltson rá a rácsnézetre és adjon hozzá egyet – pl. Állapot: Foglalt, Forgatás, Szállítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tampilan papan mengelompokkan kartu berdasarkan bidang pilihan tunggal. Beralih ke tampilan grid dan tambahkan satu — mis. Status: Terbook, Syuting, Dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La visualizzazione Schede raggruppa le carte per un campo a scelta singola. Passa alla griglia e aggiungine uno — ad es. Stato: Prenotato, In fase di ripresa, Consegnato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ボードビューは単一選択フィールドでカードをグループ化します。グリッドに切り替えて追加してください — 例：ステータス：Booked, Shooting, Delivered"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "보드 보드는 단일 선택 필드로 카드를 그룹화합니다. 그리드로 전환하여 하나 추가하세요 — 예: 상태: 예약됨, 촬영 중, 배송 완료."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brettvisning grupperer kort etter et felt med enkeltvalg. Bytt til rutenett og legg til ett – f.eks. Status: Boket, Opptak, Levert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De weergave van het bord groepeert kaarten op basis van een veld met enkele selectieopties. Schakel over naar de rasterweergave en voeg er één toe — bijv. Status: Geboekt, Opname, Geleverd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widok tablicy grupuje karty według pola z jednym wyborem. Przełącz się na widok siatki i dodaj takie pole — np. Status: Zarejestrowane, Nagrywanie, Dostarczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A visualização de quadros agrupa cartões por um campo de seleção única. Alterne para a grade e adicione um — p.ex., Status: Reservado, Em produção, Entregue."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A visualização de quadro agrupa cartões por um campo de seleção única. Mude para a grelha e adicione um — p.ex. Estado: Reservado, A gravar, Entregue."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vizualizarea Tablă grupează cardurile după un câmp cu selecție unică. Treci la grilă și adaugă unul — ex.: Status: Rezervat, Filmare, Livrat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вид доски группирует карточки по полю с одним вариантом выбора. Переключитесь на сетку и добавьте одно — например, Статус: Забронировано, Съёмка, Доставлено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brädvy grupperar kort efter ett fält för enkelval. Byt till rutnätsvyn och lägg till ett – t.ex. Status: Bokat, Inspelat, Levererat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "มุมมองกระดานจะจัดกลุ่มการ์ดตามฟิลด์เลือกค่าเดียว เปลี่ยนเป็นมุมมองตารางและเพิ่มหนึ่ง — เช่น สถานะ: จองแล้ว, กำลังถ่ายทำ, จัดส่งแล้ว."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tahta görünümü kartları tek-seçimli bir alana göre gruplar. Izgaraya geçin ve bir tane ekleyin — örn. Durum: Rezerve, Çekim, Teslim Edildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Цей вигляд дошки групує картки за полем з одним вибором. Перейдіть на сітку та додайте одне — наприклад, Статус: Замовлено, Зйомка, Доставлено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chế độ xem bảng nhóm các thẻ theo trường chọn đơn. Chuyển sang lưới và thêm một trường — ví dụ: Trạng thái: Đã đặt, Đang quay, Đã giao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "看板视图按单选字段分组卡片。切换到网格并添加一个 — 例如：状态：已预订、拍摄中、已完成"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "看板視圖依單選欄位將卡片分組。切換至網格並新增一個 — 例如：狀態：已預訂、拍攝中、已完成"
          }
        }
      }
    },
