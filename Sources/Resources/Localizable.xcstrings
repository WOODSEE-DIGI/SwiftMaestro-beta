    "Changing the model requires downloading and loading the new weights. This may take a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب تغيير النموذج تنزيل الأوزان الجديدة وتحميلها. قد يستغرق ذلك لحظة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Změna modelu vyžaduje stažení a načtení nových vah. To může chvíli trvat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Ändern des Modells erfordert das Herunterladen und Laden der neuen Gewichte. Dies kann einen Moment dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambiar el modelo requiere descargar y cargar los nuevos pesos. Esto puede llevar un momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La modifica del modello richiede il download e il caricamento dei nuovi pesi. Potrebbe richiedere un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "モデルを変更するには、新しい重みのダウンロードと読み込みが必要です。これには少し時間がかかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모델 변경 시 새 가중치를 다운로드하고 로드해야 합니다. 잠시 시간이 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alterar o modelo exige baixar e carregar os novos pesos. Isso pode levar um momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для смены модели требуется загрузка и применение новых весов. Это может занять некоторое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更改模型需要下载并加载新权重。这可能需要一点时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "變更模型需要下載並載入新的權重。這可能需要一點時間。"
          }
        }
      }
    },
