    "No secrets stored yet. Add a token below; the agent references it by name and never sees the raw value.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم تخزين أي أسرار بعد. أضف رمزًا أدناه؛ يشير الوكيل إليه بالاسم ولا يرى القيمة الخام أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ještě nejsou uložena žádná tajemství. Přidejte token níže; agent na něj odkazuje jménem a nikdy nevidí surovou hodnotu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Geheimnisse gespeichert. Fügen Sie unten ein Token hinzu; der Agent verweist darauf per Name und sieht nie den Rohwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no hay secretos almacenados. Agregue un token abajo; el agente lo referencia por nombre y nunca ve el valor crudo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun secret stocké pour le moment. Ajoutez un jeton ci-dessous ; l'agent y fait référence par son nom et ne voit jamais la valeur brute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun segreto memorizzato ancora. Aggiungi un token qui sotto; l'agente lo riferisce per nome e non vede mai il valore grezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存されたシークレットはありません。下にトークンを追加してください。エージェントは名前を参照し、生値を決して見ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보관된 비밀이 아직 없습니다. 아래에 토큰을 추가하세요; 에이전트는 이름으로 참조하며 원본 값을 절대 보지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum segredo armazenado ainda. Adicione um token abaixo; o agente referencia-o pelo nome e nunca vê o valor bruto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Секреты ещё не сохранены. Добавьте токен ниже: агент ссылается на него по имени и никогда не видит исходное значение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚未存储密钥。在下方添加令牌；代理通过名称引用它，且永远不会看到原始值。"
          }
        },
        "zh-Hant": {
