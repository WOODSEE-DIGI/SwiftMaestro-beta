        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otwórz lub upuść dokument, aby go wyświetlić lub edytować natywnie —\nbez Microsoft Office, bez LibreOffice, bez chmury."
          }
        },
        "pt-BR" : {
