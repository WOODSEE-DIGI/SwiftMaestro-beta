    "RAW decodes always export at maximum quality." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُصدَّر فكّ تشفيرات RAW دائماً بأقصى جودة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kódy RAW vždy exportují v maximální kvalitě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RAW-dekoder eksporterer altid i maksimal kvalitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RAW-Decodes werden immer mit höchster Qualität exportiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι αποκωδικοποιήσεις RAW εξάγονται πάντα σε μέγιστη ποιότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las decodificaciones RAW siempre se exportan con la máxima calidad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las decodificaciones RAW siempre se exportan con la máxima calidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RAW-dekoodaukset viedään aina maksimilaadussa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les décodages RAW sont toujours exportés à qualité maximale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פיענוחי RAW מייצאים תמיד באיכות מקסימלית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RAW डिकोड हमेशा अधिकतम गुणवत्ता पर निर्यात होते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A RAW dekódolás mindig maximális minőségben exportálódik."
