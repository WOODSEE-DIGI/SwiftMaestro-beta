    "Audio saves to disk the moment you start — transcription follows in the background.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُحفظ الصوت على القرص فور البدء — تتبع النسخ النصي في الخلفية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zvuk se ukládá na disk okamžitě po spuštění — přepis probíhá na pozadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Audio wird sofort bei Start auf Festplatte gespeichert – Transkription erfolgt im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El audio se guarda en disco al instante al iniciar — la transcripción continúa en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'audio est enregistré sur le disque dès que vous commencez — la transcription suit en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'audio viene salvato su disco non appena inizi — la trascrizione segue in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開始と同時にオーディオをディスクに保存 — 文字起こしはバックグラウンドで実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시작하자마자 오디오가 디스크에 저장되며, 전사 작업은 백그라운드에서 진행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O áudio é salvo no disco assim que você inicia — a transcrição segue em segundo plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音频在您开始时即刻保存到磁盘——转录在后台进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
