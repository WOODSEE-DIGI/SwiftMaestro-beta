    "All generation runs fully on-device via Apple MLX (mlx-swift-lm). No server, no external runtime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعمل جميع عمليات التوليد بالكامل على الجهاز عبر Apple MLX (mlx-swift-lm). لا خادم، لا بيئة تشغيل خارجية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všechna generace běží plně na zařízení přes Apple MLX (mlx-swift-lm). Žádný server, žádný externí runtime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die gesamte Generierung läuft vollständig auf dem Gerät über Apple MLX (mlx-swift-lm). Kein Server, keine externe Laufzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toda la generación se ejecuta completamente en el dispositivo mediante Apple MLX (mlx-swift-lm). Sin servidor, sin entorno externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute la génération s'exécute entièrement sur l'appareil via Apple MLX (mlx-swift-lm). Aucun serveur, aucun runtime externe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutta la generazione viene eseguita completamente sul dispositivo tramite Apple MLX (mlx-swift-lm). Nessun server, nessun runtime esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべての生成は Apple MLX (mlx-swift-lm) 経由で完全にデバイス上で実行されます。サーバーも外部ランタイムも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "모든 생성은 Apple MLX(mlx-swift-lm)를 통해 온디바이스에서 완전히 실행됩니다. 서버 없음, 외부 런타임 없음."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toda geração executa totalmente no dispositivo via Apple MLX (mlx-swift-lm). Sem servidor, sem runtime externo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все генерации выполняются полностью на устройстве через Apple MLX (mlx-swift-lm). Никакого сервера, никакого внешнего времени выполнения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有生成均通过 Apple MLX (mlx-swift-lm) 在设备上完全运行。无服务器，无外部运行时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有生成均在裝置上透過 Apple MLX (mlx-swift-lm) 完全執行。無伺服器，無外部執行環境。"
          }
        }
      }
    },
