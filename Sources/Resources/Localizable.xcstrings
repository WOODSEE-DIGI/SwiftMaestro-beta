          }
        }
      }
    },
    "SwiftMaestro runs AI models directly on your Apple Silicon Mac. No servers, no accounts, no cloud — everything stays on your machine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشغل SwiftMaestro نماذج الذكاء الاصطناعي مباشرة على جهاز Mac الخاص بك من نوع Apple Silicon. لا خوادم، ولا حسابات، ولا سحابة — كل شيء يبقى على جهازك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro führt KI-Modelle direkt auf Ihrem Apple Silicon Mac aus. Keine Server, keine Konten, keine Cloud — alles bleibt auf Ihrem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro ejecuta modelos de IA directamente en tu Mac con chip Apple Silicon. Sin servidores, sin cuentas, sin nube: todo se mantiene en tu equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro exécute les modèles d'IA directement sur votre Mac Apple Silicon. Aucun serveur, aucun compte, aucun cloud — tout reste sur votre machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro esegue modelli AI direttamente sul tuo Mac con chip Apple Silicon. Nessun server, nessun account, nessuna nuvola — tutto rimane sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro は Apple Silicon Mac で直接 AI モデルを実行します。サーバーもアカウントもクラウドも不要 — すべてのデータはローカルに保存されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro 는 Apple Silicon Mac 에서 AI 모델을 직접 실행합니다. 서버도 계정도 클라우드도 필요 없습니다 — 모든 것이 기기에 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O SwiftMaestro executa modelos de IA diretamente em seu Mac com Apple Silicon. Sem servidores, sem contas, sem nuvem — tudo fica no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro запускает ИИ-модели напрямую на вашем Mac с Apple Silicon. Никаких серверов, учётных записей или облака — всё остаётся на вашем устройстве."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro 直接在您的 Apple Silicon Mac 上執行 AI 模型。無需伺服器、帳戶或雲端 — 所有資料都保留在您的裝置上。"
          }
        }
      }
    },
    "SwiftMaestro's CPU usage — this app only, not the whole system. The graph below shows the last 60 seconds.": {
