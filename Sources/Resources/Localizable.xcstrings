    "Open or drop a document to view or edit it natively —\nno Microsoft Office, no LibreOffice, no cloud." : {
      "comment" : "A description of MaestroDocs's features.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افتح أو أفلت مستندًا لعرضه أو تحريره محليًا —\nلا Microsoft Office، لا LibreOffice، لا سحابة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otevřete nebo přetáhněte dokument pro nativní zobrazení nebo úpravu —\nžádný Microsoft Office, žádný LibreOffice, žádné cloudové služby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Åbn eller slip et dokument for at se eller redigere det lokalt — ingen Microsoft Office, ingen LibreOffice, ingen sky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffnen oder ziehen Sie ein Dokument hierher, um es nativ zu öffnen oder zu bearbeiten —\nkein Microsoft Office, kein LibreOffice, keine Cloud."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ανοίξτε ή σύρετε ένα έγγραφο για προβολή ή επεξεργασία του τοπικά — χωρίς Microsoft Office, χωρίς LibreOffice, χωρίς σύννεφο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre o arrastra un documento para verlo o editarlo de forma nativa —\nsin Microsoft Office, sin LibreOffice, sin nube."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abrir o arrastrar un documento para verlo o editarlo nativamente —\nsin Microsoft Office, sin LibreOffice, sin nube."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avaa tai pudota dokumentti nähdäksesi tai muokataksesi sitä nativisti — ei Microsoft Officea, ei LibreOfficeta, ei pilveä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez ou déposez un document pour l'afficher ou le modifier nativement —\npas de Microsoft Office, pas de LibreOffice, pas de cloud."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פתח או גרור מסמך לצפייה או עריכה מקומית —\nללא Microsoft Office, ללא LibreOffice, ללא ענן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दस्तावेज़ खोलें या इसे देखने और संपादित करने के लिए यहाँ छोड़ें —\nकोई माइक्रोसॉफ्ट ऑफ़िस नहीं, कोई लाइब्रेऑफ़िस नहीं, कोई क्लाउड नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dokumentum megnyitása vagy húzása a natív megtekintéshez és szerkesztéshez —\nnincs Microsoft Office, nincs LibreOffice, nincs felhő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buka atau seret dokumen untuk melihat atau mengeditnya secara native —\ntidak perlu Microsoft Office, tidak perlu LibreOffice, tidak perlu cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apri o trascina un documento per visualizzarlo o modificarlo in modo nativo —\nniente Microsoft Office, niente LibreOffice, niente cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドキュメントを開くかドロップして、ネイティブで表示または編集します。\nMicrosoft Office も LibreOffice も不要。クラウドも不要。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "문서를 열거나 드래그하여 네이티브로 보거나 편집하세요 —\nMicrosoft Office 도 LibreOffice 도 클라우드도 필요 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
