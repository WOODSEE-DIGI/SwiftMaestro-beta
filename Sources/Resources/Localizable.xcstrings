      }
    },
    "Notes sync across your Apple devices and are visible in iCloud Drive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتم مزامنة الملاحظات عبر أجهزة Apple الخاصة بك وتكون مرئية في iCloud Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notizen werden auf allen Ihren Apple-Geräten synchronisiert und sind im iCloud-Laufwerk sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las notas se sincronizan entre tus dispositivos Apple y son visibles en iCloud Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les notes se synchronisent sur vos appareils Apple et sont visibles dans iCloud Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le note si sincronizzano tra i tuoi dispositivi Apple e sono visibili in Archiviazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ノートはAppleデバイス間で同期され、iCloud Drive で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 기기 간 노트가 동기화되며 iCloud 드라이브에서 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notas sincronizam entre seus dispositivos Apple e são visíveis no iCloud Drive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заметки синхронизируются между устройствами Apple и доступны в iCloud Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "备注会在您的 Apple 设备间同步，并在 iCloud 云盘中可见。"
          }
        },
        "zh-Hant": {
