    "Add your first field — text, number, checkbox, date, select, rating and more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أضف حقلك الأول — نص، رقم، مربع اختيار، تاريخ، قائمة منسدلة، تقييم وأكثر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přidejte své první pole — text, číslo, zaškrtávací políčko, datum, výběr, hodnocení a další."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügen Sie Ihr erstes Feld hinzu — Text, Zahl, Kontrollkästchen, Datum, Auswahl, Bewertung und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade tu primer campo — texto, número, casilla de verificación, fecha, selección, puntuación y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez votre premier champ — texte, nombre, case à cocher, date, liste déroulante, note et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiungi il tuo primo campo — testo, numero, casella di controllo, data, selezione, valutazione e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最初のフィールドを追加してください — テキスト、数値、チェックボックス、日付、選択、評価など。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "첫 번째 필드를 추가하세요 - 텍스트, 숫자, 확인란, 날짜, 선택, 평가 등"
          }
        },
        "pt-BR": {
          "stringUnit": {
