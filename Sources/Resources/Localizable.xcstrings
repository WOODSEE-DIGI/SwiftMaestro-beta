    "Scanning identifies changed files, then uploads them to your VPS. Both happen together." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحدد المسح الملفات المتغيرة، ثم يرفعها إلى خادمك الافتراضي الخاص. يحدث الاثنان معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skenování identifikuje změněné soubory a poté je nahraje na váš VPS. Oba procesy probíhají současně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skanning identificerer ændrede filer og uploader dem til din VPS. Begge dele sker samtidig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Scannen identifiziert geänderte Dateien und lädt sie dann auf Ihren VPS hoch. Beides erfolgt gleichzeitig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η σάρωση εντοπίζει τα τροποποιημένα αρχεία και στη συνέχεια τα ανεβάζει στο VPS σας. Και τα δύο γίνονται ταυτόχρονα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El escaneo identifica los archivos modificados y luego los sube a tu VPS. Ambos procesos ocurren simultáneamente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
