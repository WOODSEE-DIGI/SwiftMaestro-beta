    "SwiftMaestro CPU % over the last 60 seconds — blue while generating, green idle, orange when stuck." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدام SwiftMaestro لـ CPU خلال آخر 60 ثانية — أزرق أثناء التوليد، أخضر في حالة الخمول، برتقالي عند التعطل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Využití procesoru SwiftMaestro za posledních 60 sekund — modrá při generování, zelená v klidu, oranžová při zaseknutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SwiftMaestro CPU % i løbet af de sidste 60 sekunder — blå under generering, grøn i hviletilstand, orange når fastlåst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SwiftMaestro CPU-% in den letzten 60 Sekunden — blau beim Erstellen, grün im Leerlauf, orange bei Blockierung."
          }
        },
        "el" : {
