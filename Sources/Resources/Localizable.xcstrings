    "Open or drop a document to view or edit it natively —\\nno Microsoft Office, no LibreOffice, no cloud.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح أو اسقط مستندًا لعرضه أو تعديله محليًا —\nبدون Microsoft Office، وبدون LibreOffice، وبدون سحابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dokument öffnen oder ablegen, um es nativ anzusehen oder zu bearbeiten —\\nkein Microsoft Office, kein LibreOffice, keine Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre o arrastra un documento para verlo o editarlo de forma nativa —\\nsin Microsoft Office, sin LibreOffice, ni nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez ou déposez un document pour le visualiser ou l'éditer nativement —\\naucun Microsoft Office, aucun LibreOffice, aucun cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ドキュメントを開くかドロップして、ネイティブで表示または編集 —\\nMicrosoft Office 不要、LibreOffice 不要、クラウド不要。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "문서를 열거나 드래그하여 원본으로 보거나 편집하세요 —\\nMicrosoft Office도 LibreOffice도 클라우드도 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开或拖放文档以原生查看或编辑 —\\n无需 Microsoft Office、LibreOffice 或云服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟或拖放文件以原生檢視或編輯 —\\n無需 Microsoft Office、LibreOffice 或雲端服務。"
          }
        }
      }
    },
