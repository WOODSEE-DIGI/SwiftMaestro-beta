    "Plan attached to this session — the agent sees its full content every turn. Click × to detach.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الخطة المرفقة بهذه الجلسة — يرى الوكيل محتواها الكامل في كل دورة. انقر على × لفك الارتباط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plán připojený k této relaci — agent vidí jeho plný obsah v každém kole. Klikněte × pro odpojení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan an diese Sitzung angehängt — der Agent sieht bei jedem Durchgang den vollständigen Inhalt. Klicken Sie auf × zum Lösen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan adjunto a esta sesión: el agente ve su contenido completo en cada turno. Haz clic en × para desvincularlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan attaché à cette session — l'agent voit son contenu intégral à chaque tour. Cliquez sur × pour détacher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piano allegato a questa sessione: l'agente visualizza il contenuto completo ad ogni turno. Clicca × per staccare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このセッションに添付されたプラン — エージェントは各ターンで完全な内容を確認します。×をクリックして取り外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 세션에 첨부된 계획 — 에이전트가 매 턴 전체 내용을 확인합니다. 분리하려면 ×를 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plano anexado a esta sessão — o agente vê todo seu conteúdo em cada turno. Clique em × para desanexar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "План, прикреплённый к этой сессии — агент видит его полное содержание каждый ход. Нажмите ×, чтобы открепить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "附加到此会话的计划 — 代理每轮都能看到其完整内容。点击 × 以分离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "附於此會話的計畫 — 代理每次回合都會看到其完整內容。點擊 × 以解除附著。"
          }
        }
      }
    },
