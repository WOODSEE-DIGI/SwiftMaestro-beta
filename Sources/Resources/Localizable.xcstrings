            "value" : "ตัวเชื่อม — ลากระหว่างรูปร่างเพื่อวาดลูกศรเวิร์กโฟลว์ (จุดปลายจะล็อกขอบรูปร่างและตามรูปร่างไป)"
          }
        },
        "tr" : {
          "stringUnit" : {
