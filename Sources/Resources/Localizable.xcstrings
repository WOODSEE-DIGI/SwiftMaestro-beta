    "Prompt sent to the vision model for each image. Keep it short and specific for faster captions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الموجه المرسَل إلى نموذج الرؤية لكل صورة. اجعله مختصراً ومحدداً للحصول على تسميات أسرع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zpráva odeslaná vizuálnímu modelu pro každý obrázek. Pro rychlejší popisky ji udržujte krátkou a konkrétní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prompt, der für jedes Bild an das Vision-Modell gesendet wird. Halte ihn kurz und spezifisch für schnellere Bildunterschriften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solicitud enviada al modelo de visión para cada imagen. Mantenla breve y específica para subtítulos más rápidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invite envoyée au modèle de vision pour chaque image. Restez concis et précis pour des légendes plus rapides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prompt inviato al modello di visione per ogni immagine. Mantienilo breve e specifico per didascalie più veloci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各画像のビジョンモデルに送信されるプロンプト。キャプション生成を高速化するには、短く具体的にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "각 이미지에 대해 비전 모델에 보내는 프롬프트입니다. 더 빠른 캡션을 위해 짧고 구체적으로 유지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prompt enviado ao modelo de visão para cada imagem. Mantenha-o curto e específico para legendas mais rápidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запрос для модели компьютерного зрения для каждого изображения. Делайте его кратким и конкретным для более быстрых подписей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为每张图像发送给视觉模型的提示。保持简短具体以获得更快的字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "傳送至視覺模型的提示（每張圖片）。保持簡潔且具體以加快標註速度。"
          }
        }
      }
    },
