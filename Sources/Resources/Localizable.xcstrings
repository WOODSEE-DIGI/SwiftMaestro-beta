    "Leave the background unset to follow the system.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اترك الخلفية غير مضبوطة لاتباع النظام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nechte pozadí nenastavené, aby se řídilo systémem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hintergrund nicht festlegen, um dem System zu folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deje el fondo sin configurar para seguir al sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laissez le fond non défini pour suivre le système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non impostare lo sfondo per seguire le impostazioni del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "背景を設定しない場合、システム設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "배경을 설정하지 않으면 시스템에 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixe o fundo sem definição para seguir o sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставьте фон без установки для следования системным настройкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不设置背景以跟随系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不設定背景以遵循系統。"
          }
        }
      }
    },
    "Let non-vision models understand images by describing them through a vision model first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دع النماذج غير البصرية تفهم الصور من خلال وصفها عبر نموذج بصري أولاً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umožněte nevizuálním modelům pochopit obrázky jejich popisem prostřednictvím vizuálního modelu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lassen Sie Nicht-Vision-Modelle Bilder verstehen, indem diese zunächst durch ein Vision-Modell beschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita que los modelos no de visión comprendan las imágenes describiéndolas primero mediante un modelo de visión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permettez aux modèles non-vision de comprendre les images en les décrivant d'abord via un modèle vision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti ai modelli senza capacità visiva di comprendere le immagini descrivendole prima tramite un modello visivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ビジョンモデルを通じて画像を記述することで、非ビジョンモデルが画像を理解できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "비전 모델이 아닌 경우 먼저 비전 모델을 통해 이미지를 설명하여 이해하도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita que modelos não visuais entendam imagens descrevendo-as primeiro através de um modelo visual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позвольте моделям без зрительных возможностей понимать изображения, сначала описывая их через модель зрения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "让非视觉模型通过先由视觉模型描述图像来理解图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "讓非視覺模型透過視覺模型先描述圖片來理解圖像。"
          }
        }
      }
    },
    "Let this finish before sending your first message for an instant reply.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اترك هذا يكتمل قبل إرسال رسالتك الأولى للحصول على رد فوري."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nechejte to dokončit před odesláním první zprávy pro okamžitou odpověď."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Warten Sie, bis dies abgeschlossen ist, bevor Sie Ihre erste Nachricht senden, um eine sofortige Antwort zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Espere a que esto termine antes de enviar su primer mensaje para una respuesta instantánea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laissez cela se terminer avant d'envoyer votre premier message pour une réponse instantanée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attendi il completamento prima di inviare il primo messaggio per una risposta immediata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最初のメッセージを送信する前にこれを完了させて即時返信を取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "즉시 응답을 받으려면 첫 메시지를 보내기 전에 이 작업을 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aguarde isso terminar antes de enviar sua primeira mensagem para uma resposta instantânea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дождитесь завершения перед отправкой первого сообщения для мгновенного ответа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发送首条消息前请等待完成，以获得即时回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "完成此步驟後再發送第一則訊息，即可獲得即時回覆。"
          }
        }
      }
    },
    "Lets models that support it reason step-by-step before answering. Per-model setting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يسمح للنماذج التي تدعمه بالتفكير خطوة بخطوة قبل الإجابة. إعداد حسب النموذج."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umožňuje modelům, které to podporují, uvažovat krok za krokem před odpovědí. Nastavení pro každý model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lässt unterstützte Modelle vor der Antwort schrittweise überlegen. Einstellung pro Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que los modelos que lo soporten razonen paso a paso antes de responder. Configuración por modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet aux modèles qui le prennent en charge de raisonner étape par étape avant de répondre. Paramètre par modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente ai modelli che lo supportano di ragionare passo dopo passo prima di rispondere. Impostazione per modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回答する前に段階的に推論することをサポートするモデル向け設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지원하는 모델은 답변하기 전에 단계별로 추론합니다. 모델별 설정입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que modelos com suporte raciocinem passo a passo antes de responder. Configuração por modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет моделям, поддерживающим это, рассуждать пошагово перед ответом. Настройка на уровне модели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "让支持该功能的模型在回答前逐步推理。按模型设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "讓支援此功能的模型在回答前先逐步推理。每項模型的設定。"
          }
        }
      }
    },
