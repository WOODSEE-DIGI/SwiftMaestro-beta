    "The audio file is moved to the Trash. This can't be undone from here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم نقل ملف الصوت إلى سلة المهملات. لا يمكن التراجع عن هذا من هنا."
          }
        },
        "de": {
          "stringUnit": {
