    "Deep integrity check: re-reads every blob and re-verifies its SHA-256. Slow on large/network repositories." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فحص تكامل عميق: يعيد قراءة كل كائن ويعيد التحقق من بصمة SHA-256 الخاصة به. بطيء في المستودعات الكبيرة أو عبر الشبكة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hloubková kontrola integrity: přečte znovu každý blob a ověří jeho SHA-256. Pomalé u velkých/síťových repozitářů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dyb integritetskontrol: genlæser hver blob og genverificerer dens SHA-256. Langsom på store/netværksbaserede repository."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiefgehende Integritätsprüfung: Liest jeden Blob erneut und verifiziert dessen SHA-256. Bei großen/Netzwerk-Repositories langsam."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Έλεγχος ακεραιότητας βάθους: επαναδιαβάζει κάθε blob και επαληθεύει εκ νέου το SHA-256 του. Αργός σε μεγάλα/δικτυακά αποθετήρια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprobación profunda de integridad: vuelve a leer cada blob y verifica su SHA-256. Lento en repositorios grandes/de red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verificación profunda de integridad: vuelve a leer cada bloque y verifica su SHA-256. Lento en repositorios grandes o de red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Syvä eheyden tarkistus: lukee uudelleen jokaisen blobin ja varmistaa sen SHA-256:n uudelleen. Hidas suurissa tai verkkorespositoreissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérification d'intégrité approfondie : relit chaque blob et re-vérifie son SHA-256. Lent sur les dépôts volumineux/réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בדיקת שלמות עמוקה: קוראת מחדש כל בלוב ומאמתת שוב את ה-SHA-256 שלו. איטית במאגרים גדולים או ברשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "गहन अखंडता जाँच: प्रत्येक ब्लॉब को पुनः पढ़ता है और इसकी SHA-256 की पुष्टि करता है। बड़े या नेटवर्क रिपॉजिटरी में धीमा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mély integritásellenőrzés: újraolvassa minden blobot és újrahitelesíti annak SHA-256 értékét. Nagy vagy hálózati tárolókban lassú."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pemeriksaan integritas mendalam: membaca ulang setiap blob dan memverifikasi kembali SHA-256-nya. Lambat pada repositori besar/jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Controllo integrità approfondito: rilegge ogni blob e verifica nuovamente il suo SHA-256. Lento su repository grandi o di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "完全整合性チェック：すべてのblobを再読み込みし、SHA-256を再検証します。大規模/ネットワークリポジトリでは時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "심층 무결성 검사: 모든 블롭을 다시 읽고 SHA-256 을 재확인합니다. 대규모/네트워크 저장소에서 느릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dyp integritetssjekk: leses alle bløtter på nytt og SHA-256 verifiseres igjen. Langsomt ved store eller nettverksbaserte lagre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diepgaande integriteitscontrole: herleest elke blob en verifieert opnieuw de SHA-256. Langzaam bij grote of netwerk-opslagplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Głęboka kontrola integralności: ponowne odczytywanie każdego bloku i weryfikacja jego SHA-256. Wolne na dużych repozytoriach sieciowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verificação profunda de integridade: relê cada blob e revalida seu SHA-256. Lento em repositórios grandes/de rede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verificação profunda de integridade: relê cada bloco e verifica novamente o seu SHA-256. Lento em repositórios grandes ou de rede."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verificare profundă a integrității: citește din nou fiecare blob și verifică din nou hash-ul său SHA-256. Lent pentru depozite mari sau de pe rețea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Глубокая проверка целостности: перечитывает каждый объект и повторно проверяет его SHA-256. Медленно для больших или сетевых репозиториев."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Djup integritetskontroll: läser om varje blob och verifierar dess SHA-256 igen. Långsam på stora eller nätverksbaserade arkiv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การตรวจสอบความสมบูรณ์เชิงลึก: อ่านข้อมูลทุกชิ้นใหม่และยืนยันค่า SHA-256 อีกครั้ง ช้าในคลังข้อมูลขนาดใหญ่หรือบนเครือข่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Derin bütünlük denetimi: Her bir blob'u yeniden okur ve SHA-256'sını doğrular. Büyük/ağ depolarında yavaştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Глибока перевірка цілісності: повторно зчитує кожен об'єкт і повторно перевіряє його SHA-256. Повільно на великих або мережевих сховищах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiểm tra tính toàn diện sâu: đọc lại mọi blob và xác minh lại SHA-256 của chúng. Chậm trên các kho lớn/mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "深度完整性检查：重新读取每个数据块并重新验证其 SHA-256。在大型/网络存储库上较慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "深度完整性檢查：重新讀取每個 blob 並重新驗證其 SHA-256。在大型或網路儲存庫上速度較慢。"
          }
        }
      }
