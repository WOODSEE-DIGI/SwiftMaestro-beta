          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro には組み込みの Markdown ノート保管庫が含まれています。ノートの保存場所を選択してください："
          }
        },
        "ko": {
          "stringUnit": {
