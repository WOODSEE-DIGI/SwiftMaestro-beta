    "Select an invoice, or create one — publish A4 tax invoice PDFs straight into MaestroDAM, export to Xero anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حدد فاتورة، أو أنشئ واحدة — انشر ملفات PDF لفواتير ضريبية بحجم A4 مباشرة في MaestroDAM، وصدّر إلى Xero في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Rechnung auswählen oder erstellen — A4-Steuerrechnungen als PDF direkt in MaestroDAM veröffentlichen, jederzeit nach Xero exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleccione una factura o cree una: publique PDF de facturas fiscales A4 directamente en MaestroDAM y exporte a Xero en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sélectionnez une facture ou créez-en une — publiez des PDF de factures fiscales A4 directement dans MaestroDAM, exportez vers Xero à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleziona una fattura o creane una — pubblica i PDF delle fatture fiscali A4 direttamente su MaestroDAM, esporta in Xero in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請求書を選択するか作成してください — A4 税務請求書 PDF を MaestroDAM に直接公開し、いつでも Xero にエクスポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영수증을 선택하거나 새로 만드세요 — A4 세금 영수증 PDF를 MaestroDAM에 바로 게시하고 언제든지 Xero로 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecione uma fatura ou crie uma — publique PDFs de faturas fiscais A4 diretamente no MaestroDAM, exporte para o Xero a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите счёт-фактуру или создайте новый — публикуйте PDF налоговых счетов формата A4 напрямую в MaestroDAM, экспортируйте в Xero в любое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择发票或创建新发票 — 将 A4 税务发票 PDF 直接发布到 MaestroDAM，随时导出至 Xero。"
          }
        },
        "zh-Hant": {
