    "Prompt sent to the vision model for each image. Keep it short and specific for faster captions." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الموجه المرسَل إلى نموذج الرؤية لكل صورة. اجعله مختصراً ومحدداً للحصول على تسميات أسرع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zpráva odeslaná vizuálnímu modelu pro každý obrázek. Pro rychlejší popisky ji udržujte krátkou a konkrétní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompten sendt til vision-modellen for hvert billede. Hold den kort og specifik for hurtigere undertekster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompt, der für jedes Bild an das Vision-Modell gesendet wird. Halte ihn kurz und spezifisch für schnellere Bildunterschriften."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ερώτημα που στέλνεται στο μοντέλο όρασης για κάθε εικόνα. Κρατήστε το σύντομο και συγκεκριμένο για ταχύτερες λεζάντες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solicitud enviada al modelo de visión para cada imagen. Mantenla breve y específica para subtítulos más rápidos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indicación enviada al modelo de visión para cada imagen. Mantenla corta y específica para subtítulos más rápidos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kuvaan lähetettävä kehotte kullekin kuvalle. Pidä se lyhyenä ja tarkkana nopeampien kuvauksien saamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Invite envoyée au modèle de vision pour chaque image. Restez concis et précis pour des légendes plus rapides."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הנחיה שנשלחת למודל הראייה עבור כל תמונה. שמור על קצר וספציפי לכיתובים מהירים יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रत्येक छवि के लिए दृष्टि मॉडल को भेजा गया संकेत। तेज़ कैप्शन के लिए इसे छोटा और विशिष्ट रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kérés, amely minden képhez elküldésre kerül a látásmodellnek. Tartsa rövidre és specifikusra a gyorsabb feliratok érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perintah yang dikirim ke model visi untuk setiap gambar. Buat singkat dan spesifik agar caption lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompt inviato al modello di visione per ogni immagine. Mantienilo breve e specifico per didascalie più veloci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各画像のビジョンモデルに送信されるプロンプト。キャプション生成を高速化するには、短く具体的にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 이미지에 대해 비전 모델에 보내는 프롬프트입니다. 더 빠른 캡션을 위해 짧고 구체적으로 유지하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oppfordring sendt til visningsmodellen for hvert bilde. Hold den kort og spesifikk for raskere bildetekster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prompt die naar het visiemodel wordt gestuurd voor elke afbeelding. Houd deze kort en specifiek voor snellere bijschriften."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Polecenie wysyłane do modelu wizyjnego dla każdego obrazu. Zachowaj je krótkie i konkretne, aby uzyskać szybsze opisy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
