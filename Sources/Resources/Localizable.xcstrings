    "Run OCR + visual fingerprinting over un-indexed assets (on-device)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تشغيل التعرف الضوئي على الحروف وبصمة بصرية على الأصول غير المفهرسة (على الجهاز)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OCR und visuelle Fingerabdruckerkennung für nicht-indizierte Assets ausführen (geräteseitig)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ejecutar OCR + huella digital visual sobre activos no indexados (en dispositivo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exécuter l'OCR et la prise d'empreinte visuelle sur les ressources non indexées (sur l'appareil)"
          }
        },
        "it": {
          "stringUnit": {
