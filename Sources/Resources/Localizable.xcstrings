        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kort bruker standardfarge som aksentfarge; korttekst har alltid kontrast mot kortet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaarten gebruiken standaard de accentkleur; tekst op kaarten contrasteert altijd met de kaart."
