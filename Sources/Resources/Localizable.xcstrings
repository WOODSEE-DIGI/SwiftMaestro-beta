    "Hold a global key to record and release to stop. Great for Stream Deck." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط باستمرار على مفتاح عام للتسجيل، وأفلته للإيقاف. مثالي لـ Stream Deck."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podržte globální klávesu pro nahrávání a uvolněte ji pro zastavení. Skvělé pro Stream Deck."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold en global taster for at optage, og slip for at stoppe. God til Stream Deck."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halten Sie eine globale Taste zum Aufnehmen und lassen Sie los, um zu stoppen. Großartig für Stream Deck."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κρατήστε ένα παγκόσμιο πλήκτρο για εγγραφή και αφήστε το για διακοπή. Ιδανικό για Stream Deck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén una tecla global para grabar y suéltala para detener. Ideal para Stream Deck."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén una tecla global para grabar y suéltala para detener. Ideal para Stream Deck."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paina globaalia näppäintä nauhoittamiseen ja vapauta lopettaaksesi. Erinomainen Stream Deckille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez une touche globale pour enregistrer et relâchez pour arrêter. Idéal pour Stream Deck."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חזק מקש גלובלי להקלטה ושחרר כדי לעצור. מצוין עבור Stream Deck."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्ड करने के लिए एक वैश्विक कुंजी दबाए रखें और रोकने के लिए छोड़ दें। स्ट्रीम डेक के लिए बेहतरीन।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tartsa nyomva a globális billentyűt a rögzítéshez, és engedje el a leállításhoz. Kiválóan használható Stream Deckkel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tahan tombol global untuk merekam dan lepaskan untuk berhenti. Cocok untuk Stream Deck."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto un tasto globale per registrare e rilascialo per fermare. Ottimo per Stream Deck."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "グローバルキーを長押しして録画を開始し、離すと停止します。Stream Deck に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "글로벌 키를 눌러 녹화하고 놓으면 중지됩니다. 스트림 데크에 적합합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold en global tast for å starte opptak og slipp for å stoppe. Bra for Stream Deck."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd een globale toets ingedrukt om op te nemen en laat los om te stoppen. Ideaal voor Stream Deck."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przytrzymaj klawisz globalny, aby nagrywać, i zwolnij, aby zatrzymać. Idealne dla Stream Deck."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha uma tecla global para gravar e solte para parar. Ótimo para o Stream Deck."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha premida uma tecla global para gravar e solte para parar. Ótimo para o Stream Deck."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Țineți apăsată o tastă globală pentru înregistrare și eliberați pentru oprire. Ideal pentru Stream Deck."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удерживайте глобальную клавишу для записи и отпустите, чтобы остановить. Отлично подходит для Stream Deck."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Håll en global tangent för att spela in och släpp för att stoppa. Fungerar bra med Stream Deck."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "กดปุ่มคีย์ลัดเพื่อบันทึก และปล่อยเพื่อหยุด เหมาะสำหรับ Stream Deck"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaydetmek için bir küresel tuşa basılı tutun, bırakmak için bırakın. Stream Deck için harika."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Утримуйте глобальну клавішу для запису та відпустіть, щоб зупинити. Чудово підходить для Stream Deck."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giữ phím toàn bộ để ghi và thả để dừng. Rất phù hợp cho Stream Deck."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住全局键开始录制，松开停止。非常适合 Stream Deck。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住全域快捷鍵開始錄製，放開即停止。非常適合搭配 Stream Deck 使用。"
          }
        }
      }
    },
