    "Deletes cookies, cache, local storage, and service workers for every site in the shared WebKit store. This signs you out of websites in SwiftBrowser." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحذف ملفات تعريف الارتباط والذاكرة المؤقتة والتخزين المحلي وخدمات العاملين لكل موقع في متجر WebKit المشترك. هذا يسجل خروجك من المواقع في SwiftBrowser."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odstraní soubory cookie, mezipaměť, místní úložiště a pracovníky služeb pro každou stránku ve sdíleném WebKit úložišti. Tím se odhlásíte z webových stránek v SwiftBrowser."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fjerner cookies, cache, lokal lagring og service-workers for alle sider i den delte WebKit-butik. Dette logger dig ud af hjemmesider i SwiftBrowser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Löscht Cookies, Cache, lokalen Speicher und Service Worker für jede Website im gemeinsamen WebKit-Speicher. Dadurch werden Sie von Websites in SwiftBrowser abgemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διαγράφονται cookies, cache, τοπική αποθήκευση και service workers για κάθε site στον κοινό κατάλογο WebKit. Αυτό σας αποσυνδέει από τις ιστοσελίδες στο SwiftBrowser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Borra cookies, caché, almacenamiento local y trabajadores de servicio para todos los sitios en la tienda WebKit compartida. Esto cierra tu sesión en los sitios web de SwiftBrowser."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina cookies, caché, almacenamiento local y trabajadores del servicio para todos los sitios en la tienda de WebKit compartida. Esto cierra sesión en los sitios de SwiftBrowser."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tyhjentää evästeet, välimuistin, paikallisen tallennustilan ja palvelutyöläiset kaikille sivustoille jaettavassa WebKit-tavaratilassa. Tämä kirjaa sinut ulos verkkosivustoista SwiftBrowserissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime les cookies, le cache, le stockage local et les service workers pour chaque site dans le magasin WebKit partagé. Cela vous déconnecte des sites web dans SwiftBrowser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מוחקת עוגיות, מטמון, אחסון מקומי ועובדי שירות לכל אתר בחנות WebKit המשותפת. פעולה זו תוציא אותך מהאתרים ב-SwiftBrowser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह कुकीज़, कैश, स्थानीय भंडार और सर्विस वर्कर्स को साझा वेबकिट स्टोर की प्रत्येक साइट से हटाता है। इससे आप SwiftBrowser की वेबसाइटों से साइन आउट हो जाते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Törli a sütiket, gyorsítótárat, helyi tárhelyet és szolgáltatási munkásokat minden oldalon a megosztott WebKit-tárban. Ez kijelentkezteti az oldalakat a SwiftBrowserben."
          }
        },
        "id" : {
