    "Notes stay in ~/Documents/SwiftMaestro Notes and are not synced.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى الملاحظات في ~/Documents/ملاحظات SwiftMaestro ولا تتم مزامنتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notizen verbleiben in ~/Documents/SwiftMaestro Notes und werden nicht synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las notas se mantienen en ~/Documentos/SwiftMaestro Notas y no se sincronizan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les notes restent dans ~/Documents/Notes SwiftMaestro et ne sont pas synchronisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le note rimangono in ~/Documenti/SwiftMaestro Note e non vengono sincronizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ノートは~/Documents/SwiftMaestro Notes に保存され、同期されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "노트는 ~/Documents/SwiftMaestro Notes 에 남아 있으며 동기화되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Notas permanecem em ~/Documentos/Notas do SwiftMaestro e não são sincronizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заметки хранятся в ~/Documents/SwiftMaestro Notes и не синхронизируются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "备注保存在 ~/Documents/SwiftMaestro Notes 中，不会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
