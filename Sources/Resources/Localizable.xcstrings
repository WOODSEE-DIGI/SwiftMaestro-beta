        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fügen Sie eine Bitcoin- oder Ethereum-Adresse oben ein, um\nKontostand, Transaktionen und Bezeichnungen der Entität zu suchen."
