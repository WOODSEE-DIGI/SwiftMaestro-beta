    "A bot token with Read Message History, View Channels, and Message Content Intent is required.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مطلوب رمز بوت يحتوي على نية قراءة سجل الرسائل، عرض القنوات، ومحتوى الرسالة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je vyžadován token Bota s oprávněním pro čtení historie zpráv, zobrazení kanálů a obsahu zpráv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Bot-Token mit den Berechtigungen Nachrichtenverlauf lesen, Kanäle anzeigen und Nachrichteninhalt-Intent ist erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se requiere un token de bot con Intención de Leer Historial de Mensajes, Ver Canales y Contenido de Mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un jeton de bot avec les autorisations Read Message History, View Channels et Message Content Intent est requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "È richiesto un token del bot con le autorizzazioni per leggere la cronologia dei messaggi, visualizzare i canali e il contenuto dei messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メッセージ履歴の読み取り、チャンネルの表示、メッセージコンテンツの意図を持つボットトークンが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메시지 기록 읽기, 채널 보기, 메시지 콘텐츠 권한이 있는 봇 토큰이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "É necessário um token de bot com as intenções Ler Histórico de Mensagens, Visualizar Canais e Conteúdo da Mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Требуется токен бота с намерениями «Читать историю сообщений», «Просматривать каналы» и «Содержимое сообщений»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要具有读取消息历史、查看频道和消息内容意图的机器人令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要具有讀取訊息歷史、查看頻道和訊息內容意圖的機器人權限。"
          }
        }
      }
    },
