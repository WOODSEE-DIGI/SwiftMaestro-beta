    "Cameras, Stream Ingest, Broadcast, Stream Mixer, NDI Browser, Color Adjustments, and Scenes are an optional add-on that isn't ready yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الكاميرات، استيعاب البث المباشر، البث، خلاط البث المباشر، متصفح NDI، تعديلات الألوان، والمشاهد هي إضافة اختيارية غير جاهزة بعد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kamery, příchozí streamování, vysílání, mixér streamů, NDI Browser, úpravy barev a scény jsou volitelný doplněk, který ještě není připraven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kameras, Stream Ingest, Broadcast, Stream Mixer, NDI Browser, Farbanpassungen und Szenen sind ein optionales Add-On, das noch nicht verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cámaras, ingestión de transmisión, emisión, mezclador de transmisión, explorador NDI, ajustes de color y escenas son una complementación opcional que aún no está lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les caméras, l'ingestion de flux, la diffusion, le mixeur de flux, NDI Browser, les réglages couleur et les scènes sont une option facultative qui n'est pas encore prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotocamere, Stream Ingest, Broadcast, Stream Mixer, NDI Browser, Regolazioni colore e Scene sono un'aggiunta opzionale non ancora pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "カメラ、ストリーム取り込み、放送、ストリームミキサー、NDI ブラウザ、色調整、シーン機能は現在準備中のオプションアドオンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "카메라, 스트림 인제스트, 브로드캐스트, 스트림 믹서, NDI 브라우저, 색상 조정 및 장면은 아직 준비되지 않은 선택형 추가 기능입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Câmeras, Entrada de Transmissão, Transmissão, Misturador de Transmissão, Navegador NDI, Ajustes de Cor e Cenas são um complemento opcional que ainda não está pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Камеры, Прием потоков, Вещание, Микшер потоков, Браузер NDI, Настройки цвета и Сцены — это дополнительный модуль, который еще не готов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相机、流输入、广播、流混音器、NDI Browser、颜色调整和场景是尚未准备好的可选附加组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相機、串流輸入、廣播、串流混音器、NDI Browser、色彩調整和場景為可選附加元件，目前尚未準備就緒。"
          }
        }
      }
    },
