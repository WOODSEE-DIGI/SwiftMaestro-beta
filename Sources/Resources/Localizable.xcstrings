    "SwiftMaestro CPU % over the last 60 seconds — blue while generating, green idle, orange when stuck.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدام SwiftMaestro لـ CPU خلال آخر 60 ثانية — أزرق أثناء التوليد، أخضر في حالة الخمول، برتقالي عند التعطل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro CPU-% in den letzten 60 Sekunden — blau beim Erstellen, grün im Leerlauf, orange bei Blockierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Porcentaje de CPU de SwiftMaestro en los últimos 60 segundos — azul mientras se genera, verde inactivo, naranja cuando está atascado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pourcentage CPU de SwiftMaestro au cours des 60 dernières secondes — bleu pendant la génération, vert en veille, orange en cas de blocage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilizzo CPU SwiftMaestro negli ultimi 60 secondi — blu durante la generazione, verde inattivo, arancione quando bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "過去 60 秒間の SwiftMaestro CPU 使用率 — 生成中は青色、アイドル時は緑色、停止時はオレンジ色"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최근 60 초 동안 SwiftMaestro CPU 사용률 — 생성 중은 파란색, 대기 중은 녹색, 멈춤 상태는 주황색."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uso de CPU do SwiftMaestro nos últimos 60 segundos — azul durante geração, verde em espera, laranja quando travado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Загрузка процессора SwiftMaestro за последние 60 секунд — синий при генерации, зелёный в простое, оранжевый при зависании."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "過去 60 秒內 SwiftMaestro CPU 使用率 — 生成時為藍色，閒置時為綠色，卡住時為橘色。"
          }
        }
      }
    },
    "SwiftMaestro includes a built-in Markdown notes vault. Choose where your notes are stored:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي SwiftMaestro على خزان ملاحظات Markdown مدمج. اختر مكان تخزين ملاحظاتك:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro enthält einen integrierten Markdown-Notizspeicher. Wählen Sie, wo Ihre Notizen gespeichert werden:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SwiftMaestro incluye una bóveda de notas Markdown integrada. Elige dónde se almacenan tus notas:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
