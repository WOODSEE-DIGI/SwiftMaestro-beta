    "Deletes cookies, cache, local storage, and service workers for every site in the shared WebKit store. This signs you out of websites in SwiftBrowser.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحذف ملفات تعريف الارتباط والذاكرة المؤقتة والتخزين المحلي وخدمات العاملين لكل موقع في متجر WebKit المشترك. هذا يسجل خروجك من المواقع في SwiftBrowser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odstraní soubory cookie, mezipaměť, místní úložiště a pracovníky služeb pro každou stránku ve sdíleném WebKit úložišti. Tím se odhlásíte z webových stránek v SwiftBrowser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löscht Cookies, Cache, lokalen Speicher und Service Worker für jede Website im gemeinsamen WebKit-Speicher. Dadurch werden Sie von Websites in SwiftBrowser abgemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Borra cookies, caché, almacenamiento local y trabajadores de servicio para todos los sitios en la tienda WebKit compartida. Esto cierra tu sesión en los sitios web de SwiftBrowser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime les cookies, le cache, le stockage local et les service workers pour chaque site dans le magasin WebKit partagé. Cela vous déconnecte des sites web dans SwiftBrowser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cancella i cookie, la cache, l'archivio locale e i worker di servizio per tutti i siti nell'archivio WebKit condiviso. Questo ti disconnette dai siti web in SwiftBrowser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "共有 WebKit ストアのすべてのサイトのクッキー、キャッシュ、ローカルストレージ、サービスワーカーを削除します。これにより、SwiftBrowser のウェブサイトからサインアウトされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "공유 WebKit 스토어의 모든 사이트에 대한 쿠키, 캐시, 로컬 저장소 및 서비스 워커가 삭제됩니다. SwiftBrowser의 웹사이트에서 로그아웃됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exclui cookies, cache, armazenamento local e trabalhadores de serviço para todos os sites na loja WebKit compartilhada. Isso faz você sair dos sites no SwiftBrowser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Очищает файлы cookie, кэш, локальное хранилище и сервисные воркеры для всех сайтов в общем хранилище WebKit. Это завершает сеанс на сайтах в SwiftBrowser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除共享 WebKit 存储中每个网站的 Cookie、缓存、本地存储和服务工作者。这将使您从 SwiftBrowser 中的网站登出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刪除共享 WebKit 儲存區中每個網站的 Cookie、快取、本機儲存空間和服務工作程式。這將使您從 SwiftBrowser 中的網站登出。"
          }
        }
      }
    },
