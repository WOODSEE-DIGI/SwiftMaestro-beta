    "A bot token with Read Message History, View Channels, and Message Content Intent is required." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مطلوب رمز بوت يحتوي على نية قراءة سجل الرسائل، عرض القنوات، ومحتوى الرسالة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je vyžadován token Bota s oprávněním pro čtení historie zpráv, zobrazení kanálů a obsahu zpráv."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En bot-token med tilladelserne Læs beskedhistorik, Se kanaler og Beskedsindhold er påkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Bot-Token mit den Berechtigungen Nachrichtenverlauf lesen, Kanäle anzeigen und Nachrichteninhalt-Intent ist erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Απαιτείται διακριτικό bot με προθέσεις ανάγνωσης ιστορικού μηνυμάτων, προβολής καναλιών και περιεχομένου μηνυμάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se requiere un token de bot con Intención de Leer Historial de Mensajes, Ver Canales y Contenido de Mensaje."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se requiere un token de bot con las intenciones Leer historial de mensajes, Ver canales y Contenido del mensaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bot-tunnus, jossa on lukuviestihistoria-, kanavakatselu- ja viestisisältö-oikeudet, vaaditaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un jeton de bot avec les autorisations Read Message History, View Channels et Message Content Intent est requis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "נדרש אסימון בוט עם כוונות לקריאת היסטוריית הודעות, הצגת ערוצים ותוכן ההודעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
