        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ještě nejsou žádná pravidla. Přidejte pravidlo níže; povolená pravidla jsou vložena jako systémový příkaz na začátku každé konverzace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noch keine Regeln. Fügen Sie unten eine Regel hinzu; aktivierte Regeln werden als Systemanweisung am Anfang jedes Gesprächs eingefügt."
