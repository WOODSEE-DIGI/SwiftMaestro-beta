    "Program your Stream Deck button to emit this key. Hold = record, release = stop + auto-send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "برمج زر Stream Deck الخاص بك لإصدار هذا المفتاح. اضغط باستمرار = تسجيل، أفلت = إيقاف + إرسال تلقائي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naprogramujte tlačítko Stream Deck pro vyslání této klávesy. Podržení = nahrávání, uvolnění = zastavení + automatické odeslání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Programmiere deine Stream Deck-Taste, um diesen Key auszulösen. Halten = Aufnahme, loslassen = Stoppen + automatisches Senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Programa el botón de tu Stream Deck para emitir esta tecla. Mantener = grabar, soltar = detener + envío automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Programmez votre bouton Stream Deck pour émettre cette touche. Maintien = enregistrement, relâchement = arrêt + envoi auto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Programma il pulsante Stream Deck per emettere questo tasto. Tieni premuto = registra, rilascia = arresta + invio automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このキーを出力するように Stream Deck ボタンを設定します。長押し = 記録、離す = 停止 + 自動送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stream Deck 버튼을 이 키를 내보내도록 프로그래밍하세요. 누르고 있음 = 녹음, 놓기 = 중지 + 자동 전송"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configure o botão do Stream Deck para emitir esta tecla. Segurar = gravar, soltar = parar + envio automático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Настройте кнопку Stream Deck для отправки этой клавиши. Удержание = запись, отпускание = стоп + автоотправка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为 Stream Deck 按钮编程以发出此按键。按住 = 录制，释放 = 停止 + 自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將 Stream Deck 按鈕設定為發出此按鍵。按住 = 錄製，放開 = 停止 + 自動傳送。"
          }
        }
      }
    },
