<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: SwiftMaestro needs full system access (local model files,
	     authorized folders, MCP subprocesses). Distributed via Developer ID +
	     notarization, not the App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hugging Face Hub model downloads, optional MCP/web tools. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- User-chosen files/folders via open panels. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Calendar and Reminders access via EventKit. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.reminders</key>
	<true/>
	<!-- Contacts access for the built-in CRM-style contact manager. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Photos library access for listing albums and assets. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- Apple Events automation (e.g. Notes) for the native macOS integration. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Microphone access for Voice Notes + chat push-to-talk dictation.
	     REQUIRED by the hardened runtime: without this entitlement the audio
	     subsystem denies input at the process level even when the System
	     Settings → Privacy & Security → Microphone TCC toggle is ON, and
	     requestRecordPermission() reports denied regardless of the grant. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Load third-party dylibs signed by other teams (Homebrew libusb/libraw
	     for tethering). Required once the Debug config signs with a stable
	     identity: hardened-runtime library validation otherwise rejects them
	     and dyld aborts at launch. Harmless here — the app is unsandboxed and
	     already runs arbitrary local tooling/MCP subprocesses by design. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Hardened Runtime requires an explicit keychain access group for
	     writes to the legacy login keychain. Without this entitlement,
	     SecItemAdd can fail with errSecMissingEntitlement (-34018) on some
	     signed builds. The app identifier prefix resolves to TeamID.BundleID. -->
	<key>com.apple.security.cs.keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
